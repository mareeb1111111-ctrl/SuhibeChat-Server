# مفتاح التشفير الأساسي (يجب أن يكون طويلاً وعشوائياً - استخدم openssl rand -hex 32)
SECRET_KEY=your_super_secret_key_here

# إعدادات Mesibo
APP_TOKEN=your_mesibo_app_token_here
MESIBO_API_URL=https://api.mesibo.com/backend/

# إعدادات المدير
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# إعدادات البريد SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=True

# مسار قاعدة البيانات
DATABASE_URL=sqlite:///./chat_server.db

# إعدادات التطبيق الأساسية
DEBUG=false
ALLOWED_HOSTS=*
